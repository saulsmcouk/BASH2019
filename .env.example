# Copy this file to .env and fill in your API keys
# Do NOT commit .env to version control

# Port the server listens on (optional, defaults to 3000)
PORT=3000

# Mapbox public token (https://account.mapbox.com/)
MAPBOX_TOKEN=your_mapbox_token_here

# TheyWorkForYou API key (https://www.theyworkforyou.com/api/key)
THEYWORKFORYOU_KEY=your_theyworkforyou_key_here

# Companies House API key (https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_KEY=your_companies_house_key_here
